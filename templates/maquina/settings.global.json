{
  "extraKnownMarketplaces": {
    "superpowers-marketplace": { "source": { "source": "github", "repo": "obra/superpowers-marketplace" } },
    "typesafe-ai": { "source": { "source": "github", "repo": "typesafe-ai/skills" } }
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "typesafe@typesafe-ai": true
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/bloqueia-pkill-f.sh" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "$HOME/.local/bin/rtk hook claude" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/pedidos-do-dono.py" }] }
    ]
  }
}
